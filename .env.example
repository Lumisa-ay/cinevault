# Host port; only bound on 127.0.0.1.
CINEVAULT_PORT=5188
# Use forward slashes for Windows paths, for example D:/Movies/CineVault
CINEVAULT_DOWNLOADS_PATH=./downloads

# Source options for this deployment
CINEVAULT_RESPECT_ROBOTS=false
CINEVAULT_SOURCE_PROXY=http://http.docker.internal:3128

# Optional: TMDB v3 API key, kept on the server; never returned to the browser.
CINEVAULT_TMDB_API_KEY=
CINEVAULT_JUSTWATCH_REGION=jp

# Optional BT sidecars; enabled by scripts/update-local.ps1 -EnableBt
CINEVAULT_QBIT_PORT=8081
CINEVAULT_PROWLARR_PORT=9696

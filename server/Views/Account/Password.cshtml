@model ChangePasswordInput
@{ Layout = "_AccountLayout"; ViewData["Title"] = "修改密码"; }
<section class="login-card"><div class="eyebrow">ACCOUNT SETTINGS</div>
<h1>修改登录密码</h1><p class="muted">当前账户：@User.Identity?.Name。修改成功后需要重新登录。</p>
<form method="post" action="/account/password">@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="form-error" role="alert"></div>
<label class="form-field"><span>当前密码</span><input type="password" name="CurrentPassword" required autocomplete="current-password" maxlength="128"></label>
<label class="form-field"><span>新密码</span><input type="password" name="NewPassword" required autocomplete="new-password" minlength="12" maxlength="128"><small>12–128 个字符</small></label>
<label class="form-field"><span>确认新密码</span><input type="password" name="ConfirmPassword" required autocomplete="new-password" minlength="12" maxlength="128"></label>
<button class="btn primary login-submit" type="submit">保存新密码</button>
</form></section>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "AllowedDownloadRoots": [],
  "Crawler": {
    "BaseUrl": "https://www.gying.net/",
    "ListPaths": [
      "/"
    ],
    "MaxDetailPages": 15,
    "DelayMilliseconds": 1200,
    "DetailPathPattern": "/(?:mv|movie|tv|vod|detail|play|series)[/._-]",
    "RatingPattern": "(?:豆瓣|douban)[\\s\\S]{0,120}?(?<rating>[0-9]\\.[0-9])",
    "GenrePattern": "(?:类型|genre)[^<]{0,20}[：:]\\s*(?<genre>[^<\\r\\n]{1,60})",
    "RespectRobotsTxt": true
  }
}
